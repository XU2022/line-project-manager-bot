# Copy this file to .env and replace every placeholder locally.
# Never commit the resulting .env file.

LINE_CHANNEL_SECRET=replace_with_your_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=replace_with_your_channel_access_token
LINE_ALLOWED_GROUPS=C_REPLACE_WITH_GROUP_ID
LINE_REMINDER_GROUP_ID=C_REPLACE_WITH_GROUP_ID
LINE_BOOTSTRAP_MODE=false
# Prefer a real @mention. This single letter is only the fallback trigger.
LINE_FALLBACK_TRIGGER_LETTER=H
BOT_LOCALE=en
PROJECT_DB_PATH=/opt/line-project-manager/state/tasks.sqlite3
MEMBER_CONFIG_PATH=/opt/line-project-manager/config/members.json
LINE_HOST=127.0.0.1
LINE_PORT=8646
PROJECT_TIMEZONE=Asia/Tokyo
REMINDER_HOUR=12
MONTHLY_MESSAGE_LIMIT=200
ESTIMATED_PUSH_COST=3
